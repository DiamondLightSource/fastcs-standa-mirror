    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Unit Test",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "${file}",
            "purpose": [
                "debug-test"
            ],
            "console": "integratedTerminal",
        },
        {
            "name": "Standa Motorised Mirror IOC",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "module": "fastcs_standa_mirror",
            "args": [
                "run",
                "${workspaceFolder:fastcs-standa-mirror}/src/fastcs_standa_mirror/fastcs.yaml",
                "--log-level",
                "TRACE",
            ],
            "console": "integratedTerminal",
        },
    ]
}
